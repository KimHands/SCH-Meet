# deploy/.env — 서버에서만 만든다(cp .env.example .env && chmod 600 .env). 값은 레포·채팅에 붙여넣지 않는다.

# 공개 도메인(필수). 예: sch-meet.example.com
PUBLIC_HOST=

# Postgres 비밀번호: openssl rand -hex 24
POSTGRES_PASSWORD=

# Django 비밀키: openssl rand -hex 32. 바꾸면 기존 로그인이 모두 풀린다
DJANGO_SECRET_KEY=

# Google OAuth 클라이언트 ID. API의 토큰 검증과 웹 이미지 빌드에 함께 쓰인다
GOOGLE_CLIENT_ID=

# 백업 대상 Cloudflare R2 (버킷 하나만 Object Read & Write 권한인 API 토큰)
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=

# (선택) 백업 실패 Telegram 알림. 비우면 알림만 꺼진다
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (선택) 기본값을 바꿀 때만
# BACKUP_CRON=
# BACKUP_KEEP_DAYS=
