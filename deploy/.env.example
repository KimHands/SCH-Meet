# deploy/.env — 서버에서만 만든다(cp .env.example .env && chmod 600 .env). 값은 레포·채팅에 붙여넣지 않는다.

# 공개 도메인. 비우면 sch-meet.kimhands.com
PUBLIC_HOST=

# Postgres 비밀번호: openssl rand -hex 24
POSTGRES_PASSWORD=

# Django 비밀키: openssl rand -hex 32. 바꾸면 기존 로그인이 모두 풀린다
DJANGO_SECRET_KEY=

# Google OAuth. 두 클라이언트 ID는 같은 값이고, VITE_ 쪽은 이미지 빌드에 쓰인다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# OCR.space. 공개 git 이력에 남은 옛 키를 쓰지 말고 재발급한 키를 넣는다
OCR_SPACE_API_KEY=

# 백업 대상 Cloudflare R2 (버킷 하나만 Object Read & Write 권한인 API 토큰)
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=

# (선택) 기본값을 바꿀 때만
# BACKUP_CRON=
# BACKUP_KEEP_DAYS=
