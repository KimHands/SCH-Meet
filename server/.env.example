# Django
# 필수: 강력한 비밀키를 주입하세요(미설정 시 서버 기동 중단).
# 생성: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_STRONG_SECRET
# 운영은 반드시 False, 로컬 개발에서만 True 권장
DJANGO_DEBUG=False
# 추가 허용 호스트(콤마 구분). localhost·127.0.0.1은 기본 허용
DJANGO_ALLOWED_HOSTS=
# 관리자 페이지(/admin/)는 기본 비노출. 필요할 때만 True
DJANGO_ADMIN_ENABLED=False

# 프론트엔드
# CORS 허용 오리진(콤마 구분). localhost:5173·5174는 기본 허용
FRONTEND_ORIGINS=
# 초대 링크에 쓰이는 프론트 주소
FRONTEND_BASE_URL=http://localhost:5173

# DB: 비워두면 로컬 SQLite 사용. 운영은 Render가 자동 주입
DATABASE_URL=
# DATABASE_URL 사용 시 SSL 요구 여부. 내부 네트워크의 SSL 없는 DB에서만 False (OCI는 deploy/compose.yml에서 지정)
DATABASE_SSL_REQUIRE=True

# HTTPS 프록시 뒤(OCI)
# HTTPS 리다이렉트·HSTS·보안 쿠키를 켠다. Render는 RENDER=true로 자동으로 켜지므로 불필요
DJANGO_BEHIND_HTTPS_PROXY=False
# 프록시가 클라이언트 값을 덮어쓰는 IP 헤더(OCI: CF-Connecting-IP). 비우면 X-Forwarded-For 처리 사용
CLIENT_IP_HEADER=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OCR.space (시간표 이미지 인식)
OCR_SPACE_API_KEY=
